            const btn = document.getElementById('saved-spots-toggle');
            if (btn) {
                btn.className = showSavedOnly
                    ? 'px-2.5 py-1 rounded-xl bg-purple-600 text-white text-[11px] font-bold border border-purple-600 transition shadow-sm'
                    : 'px-2.5 py-1 rounded-xl bg-white text-purple-700 text-[11px] font-bold border border-purple-200 transition shadow-sm';
                btn.innerHTML = `<i class="fa-${showSavedOnly ? 'solid' : 'regular'} fa-bookmark mr-1"></i>我的收藏 <span id="saved-spots-count">${savedSpotIds.length}</span>`;
            }
        }

        function toggleSavedOnly() {
            showSavedOnly = !showSavedOnly;
            updateSavedSpotsUI();
            renderSpots();
        }

        function toggleSaveSpot(spotId) {
            if (savedSpotIds.includes(spotId)) {
                savedSpotIds = savedSpotIds.filter(id => id !== spotId);
                showToast('已從我的收藏移除', 'fa-bookmark');
            } else {
                savedSpotIds.push(spotId);
                showToast('已儲存到「想去的景點／咖啡廳」', 'fa-bookmark');
            }
            updateSavedSpotsUI();
            renderSpots();
            const spot = SPOTS.find(s => s.id === spotId);
            if (spot) updateModalSaveButton(spot);
        }

        function updateModalSaveButton(spot) {
            const btn = document.getElementById('modal-save-btn');
            if (!btn) return;
            const saved = savedSpotIds.includes(spot.id);
            btn.innerHTML = `<i class="fa-${saved ? 'solid' : 'regular'} fa-bookmark"></i> ${saved ? '已收藏' : '收藏想去'}`;
        }

        function filterSpots() {
            renderSpots();
            renderEventsList();
        }

        function renderGroupPills() {
            const container = document.getElementById('group-pills');
            if (!container) return;

            container.innerHTML = GROUPS.map(g => {
                const isActive = selectedGroup === g.id;
                const activeClasses = isActive 
                    ? 'bg-purple-600 text-white shadow-sm font-bold' 
                    : 'bg-white hover:bg-purple-50 text-slate-700 border border-purple-200';
                return `
                    <button onclick="selectGroup('${g.id}')" class="px-3 py-1.5 rounded-xl text-xs transition flex items-center gap-1.5 whitespace-nowrap ${activeClasses}">
                        <i class="fa-solid ${g.icon} text-[11px]"></i>
                        <span>${g.name}</span>
                    </button>
                `;
            }).join('');
        }

        function selectGroup(groupId) {
            selectedGroup = groupId;
            renderGroupPills();
            filterSpots();
        }

        function populateGroupSelects() {
            const spotSelect = document.getElementById('add-group');
            const eventSelect = document.getElementById('event-group');
            const options = GROUPS.filter(g => g.id !== 'ALL').map(g => `
                <option value="${g.id}">${g.name}</option>
            `).join('');

            if (spotSelect) spotSelect.innerHTML = options;
            if (eventSelect) eventSelect.innerHTML = options;
        }

        // Render Spots and Events on Map
        function renderSpots() {
            const listContainer = document.getElementById('tab-content-spots');
            const spots = getFilteredSpots();
            
            markers.forEach(m => map.removeLayer(m));
            markers = [];

            const badge = document.getElementById('sidebar-count-badge');
            if (badge) badge.innerText = `${spots.length} 個巡禮點`;

            if (!listContainer) return;

            if (spots.length === 0) {
                listContainer.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <i class="fa-solid fa-compass text-3xl mb-2 text-slate-300 block"></i>
                        <p class="text-xs">沒有找到符合條件的追星地點或應援活動</p>
                    </div>
                `;
                return;
            }

            let html = '';
            spots.forEach(spot => {
                const groupObj = GROUPS.find(g => g.id === spot.groupId) || { color: '#9333ea', name: spot.groupName };
                
                let distText = '';
                if (userLocation) {
                    const dist = calculateDistance(userLocation.lat, userLocation.lng, spot.lat, spot.lng);
                    distText = `・<span class="text-purple-600 font-bold">${formatDistance(dist)}</span>`;
                }

                const iconHtml = spot.isEvent ? `
                    <div class="relative group cursor-pointer animate-bounce">
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-amber-500 via-pink-500 to-purple-600 flex items-center justify-center text-white text-base shadow-lg border-2 border-white">
                            <i class="fa-solid fa-cake-candles"></i>
                        </div>
                    </div>
                ` : `
                    <div class="relative group cursor-pointer">
                        <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-white text-sm shadow-md border-2 border-white transition transform group-hover:scale-110" style="background-color: ${groupObj.color}">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                    </div>
                `;

                const markerIcon = L.divIcon({
                    className: 'custom-spot-marker',
                    html: iconHtml,
                    iconSize: [38, 38],
                    iconAnchor: [19, 19]
                });

                const marker = L.marker([spot.lat, spot.lng], { icon: markerIcon }).addTo(map);
                marker.bindPopup(`
                    <div class="p-3 bg-white text-slate-800 rounded-2xl font-sans">
                        <div class="relative h-28 w-full rounded-xl overflow-hidden mb-2">
                            <img src="${spot.heroImage}" class="w-full h-full object-cover">
                            <span class="absolute top-2 left-2 text-[10px] px-2 py-0.5 rounded-md font-bold text-white shadow-xs" style="background-color: ${spot.isEvent ? '#f59e0b' : groupObj.color}">
                                ${spot.isEvent ? '🎂 應援活動' : spot.groupName}
                            </span>
                        </div>
                        <h3 class="font-bold text-xs text-slate-900 line-clamp-1 mb-0.5">${spot.title}</h3>
                        <p class="text-[11px] text-pink-600 font-semibold mb-2">${spot.idolName}</p>
                        <button onclick="openSpotModal(${spot.id})" class="w-full py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold shadow-xs transition">
                            查看詳情與導航
                        </button>
                    </div>
                `, { closeButton: false });

                markers.push(marker);

                html += `
                    <div onclick="openSpotModal(${spot.id})" class="bg-white hover:bg-purple-50/60 border border-purple-100 hover:border-purple-300 p-3 rounded-2xl cursor-pointer transition flex gap-3 shadow-xs group relative">
                        <img src="${spot.heroImage}" class="w-20 h-20 rounded-xl object-cover shrink-0 border border-purple-100">
                        <button onclick="event.stopPropagation(); toggleSaveSpot(${spot.id})" class="absolute top-2 right-2 w-7 h-7 rounded-full bg-white/95 border border-purple-200 text-purple-600 shadow-sm flex items-center justify-center" title="收藏">
                            <i class="fa-${savedSpotIds.includes(spot.id) ? 'solid' : 'regular'} fa-bookmark text-xs"></i>
                        </button>
                        <div class="flex-1 min-w-0 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center gap-1.5 mb-1">
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded text-white" style="background-color: ${spot.isEvent ? '#f59e0b' : groupObj.color}">
                                        ${spot.isEvent ? '🎂 應援咖啡廳' : spot.groupName}
                                    </span>
                                    <span class="text-[10px] text-slate-500 font-medium">${spot.category}</span>
                                </div>
                                <h3 class="text-xs font-bold text-slate-800 truncate group-hover:text-purple-700 transition">${spot.title}</h3>
                                <p class="text-[11px] text-pink-600 font-semibold truncate mt-0.5">${spot.idolName}</p>
                            </div>
                            <div class="text-[10px] text-slate-500 truncate flex items-center gap-1 mt-1">
                                <i class="fa-solid fa-location-dot text-purple-400"></i>
                                <span class="truncate">${spot.address} ${distText}</span>
                            </div>
                        </div>
                    </div>
                `;
            });

            listContainer.innerHTML = html;
        }

        // Render Events Directory Tab
        function renderEventsList() {
            const container = document.getElementById('events-list-container');
            if (!container) return;

