                                    <i class="fa-solid fa-user"></i>
                                </div>
                            </div>
                        `,
                        iconSize: [24, 24],
                        iconAnchor: [12, 12]
                    });

                    userMarker = L.marker([lat, lng], { icon: userIcon }).addTo(map);
                    userMarker.bindPopup('<div class="p-2 text-xs font-bold text-center text-slate-800">您的位置 (Real GPS)</div>');

                    map.flyTo([lat, lng], 14, { duration: 1.5 });

                    document.getElementById('location-banner').classList.remove('hidden');
                    document.getElementById('location-status-text').innerText = `已成功定位在 (${lat.toFixed(4)}, ${lng.toFixed(4)})`;

                    renderSpots();
                    showToast("成功取得您的真實 GPS 定位！", "fa-location-arrow");
                },
                (error) => {
                    console.error("Geolocation error:", error);
