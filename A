<!DOCTYPE html>
<html lang="zh-TW" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>K-Spot Radar | 追星巡禮與應援活動地圖</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', '"Noto Sans TC"', 'sans-serif'],
                    },
                    colors: {
                        lavender: {
                            50: '#faf5ff',
                            100: '#f3e8ff',
                            200: '#e9d5ff',
                            300: '#d8b4fe',
                            400: '#c084fc',
                            500: '#a855f7',
                            600: '#9333ea',
                            700: '#7e22ce',
                            800: '#6b21a8',
                            900: '#581c87',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom Leaflet Map Styling for White & Light Purple Theme */
        .leaflet-popup-content-wrapper {
            padding: 0;
            overflow: hidden;
            border-radius: 1.25rem;
            box-shadow: 0 15px 30px -5px rgba(147, 51, 234, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            background: #ffffff;
            border: 1px solid #f3e8ff;
        }
        .leaflet-popup-content {
            margin: 0 !important;
            width: 280px !important;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #faf5ff;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #e9d5ff;
            border-radius: 99px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #c084fc;
        }
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.9; }
            50% { transform: scale(1.25); opacity: 0.3; }
            100% { transform: scale(0.95); opacity: 0.9; }
        }
        .gps-pulse {
            animation: pulse-ring 2s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 h-full font-sans flex flex-col overflow-hidden">

    <!-- Top Navigation Header -->
    <header class="bg-white/90 backdrop-blur-md border-b border-purple-100 z-30 shrink-0 shadow-sm">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 gap-2 sm:gap-4">
                
                <!-- Logo & Brand -->
                <div class="flex items-center gap-2.5 cursor-pointer" onclick="centerOnKorea()">
                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-purple-500/20 shrink-0">
                        <i class="fa-solid fa-location-dot text-xl"></i>
                    </div>
                    <div>
                        <h1 class="font-black text-base sm:text-lg tracking-tight text-slate-900 flex items-center gap-2">
                            K-SPOT RADAR <span class="text-[10px] sm:text-xs px-2 py-0.5 rounded-full bg-purple-100 text-purple-700 font-bold border border-purple-200">追星與應援</span>
                        </h1>
                        <p class="text-[11px] text-slate-500 hidden sm:block">愛豆聖地打卡・生日咖啡廳・個人巡禮主頁</p>
                    </div>
                </div>

                <!-- Action Controls & User Account Profile Badge -->
                <div class="flex items-center gap-2">
                    
                    <!-- Real GPS Geolocation Button -->
                    <button id="btn-locate" onclick="requestRealGPS()" class="flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-purple-50 hover:bg-purple-100 border border-purple-200 text-xs font-semibold text-purple-700 transition">
                        <i id="gps-icon" class="fa-solid fa-location-crosshairs text-purple-600"></i>
                        <span id="gps-text" class="hidden md:inline">我的真實定位</span>
                    </button>

                    <!-- Add Fan Event / Birthday Cafe Button -->
                    <button onclick="openAddEventModal()" class="flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-gradient-to-r from-amber-500 to-pink-500 hover:from-amber-600 hover:to-pink-600 text-white text-xs font-bold shadow-md shadow-amber-500/15 transition transform active:scale-95">
                        <i class="fa-solid fa-cake-candles text-sm"></i>
                        <span class="hidden sm:inline">宣傳應援活動</span>
                        <span class="sm:hidden">應援</span>
                    </button>

                    <!-- Add Spot Button -->
                    <button onclick="openAddSpotModal()" class="flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white text-xs font-bold shadow-md shadow-purple-600/15 transition transform active:scale-95">
                        <i class="fa-solid fa-plus"></i>
                        <span class="hidden sm:inline">新增景點</span>
                        <span class="sm:hidden">景點</span>
                    </button>

                    <!-- User Personal Profile Homepage Button -->
                    <button onclick="openProfileModal()" class="flex items-center gap-2 pl-2 pr-2.5 py-1 rounded-xl bg-purple-50 hover:bg-purple-100 border border-purple-200 text-xs font-medium transition shadow-sm">
                        <img id="header-user-avatar" class="w-6 h-6 rounded-full object-cover border border-purple-400">
                        <span id="header-user-name" class="font-bold text-slate-800 max-w-[80px] sm:max-w-[100px] truncate">我的主頁</span>
                        <span id="friends-badge-count" class="bg-pink-500 text-white text-[10px] font-black px-1.5 py-0.2 rounded-full">0</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Group Selector & Filters Row -->
        <div class="bg-purple-50/50 border-t border-purple-100 px-4 py-2 overflow-x-auto custom-scrollbar">
            <div class="max-w-7xl mx-auto flex items-center gap-2 min-w-max">
                <span class="text-xs font-bold text-purple-800 uppercase tracking-wider mr-1 flex items-center gap-1">
                    <i class="fa-solid fa-heart text-pink-500 text-[10px]"></i> 偶像:
                </span>
                
                <!-- Group Filter Pills -->
                <div id="group-pills" class="flex items-center gap-2"></div>

                <div class="h-4 w-[1px] bg-purple-200 mx-1"></div>

                <!-- Category Filter -->
                <select id="category-filter" onchange="filterSpots()" class="bg-white border border-purple-200 text-xs rounded-xl px-3 py-1.5 text-slate-700 focus:outline-none focus:ring-2 focus:ring-purple-400">
                    <option value="ALL">全部分類 (景點/應援/美食)</option>
                    <option value="應援活動">🎂 應援咖啡廳/粉絲活動</option>
                    <option value="MV拍攝">🎬 MV 拍攝地</option>
                    <option value="美食餐廳">🍜 同款美食/餐廳</option>
                    <option value="節目/旅遊">✈️ 綜藝/旅遊景點</option>
                    <option value="粉絲私房">⭐ 粉絲推薦/私房打卡</option>
                </select>

                <!-- Search Input -->
                <div class="relative ml-auto">
                    <input type="text" id="search-input" onkeyup="filterSpots()" placeholder="搜尋景點/偶像/應援..." class="w-36 sm:w-56 bg-white border border-purple-200 text-xs rounded-xl pl-8 pr-3 py-1.5 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-400 shadow-sm">
                    <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2 text-purple-400 text-xs"></i>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col md:flex-row relative overflow-hidden">
        
        <!-- Interactive Map Container -->
        <div class="flex-1 relative h-[50vh] md:h-full w-full">
            <div id="map" class="w-full h-full bg-slate-100 z-10"></div>

            <!-- Floating Map Selection Mode Banner -->
            <div id="picking-location-banner" class="hidden absolute top-4 left-1/2 -translate-x-1/2 z-30 bg-purple-900 text-white border border-purple-400 backdrop-blur-md px-4 py-2.5 rounded-2xl shadow-xl flex items-center gap-3 animate-bounce">
                <i class="fa-solid fa-hand-pointer text-amber-300 text-lg"></i>
                <div class="text-xs">
                    <span class="font-bold block text-white">請點擊地圖上的任意位置</span>
                    <span class="text-purple-200 text-[11px]">確定地點座標（景點或應援活動）</span>
                </div>
                <button onclick="cancelLocationPicker()" class="ml-2 px-2.5 py-1 bg-purple-950 hover:bg-slate-800 rounded-lg text-xs text-purple-200 border border-purple-700">取消</button>
            </div>

            <!-- GPS Status Banner -->
            <div id="location-banner" class="hidden absolute top-4 left-4 z-20 bg-white/95 backdrop-blur-md border border-purple-200 rounded-2xl p-3 shadow-lg max-w-xs">
                <div class="flex items-start gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-purple-100 flex items-center justify-center text-purple-600 shrink-0 mt-0.5">
                        <i class="fa-solid fa-location-arrow"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-800">真實 GPS 已定位</span>
                            <button onclick="clearGPS()" class="text-slate-400 hover:text-slate-600 text-xs"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                        <p id="location-status-text" class="text-[11px] text-slate-500 truncate mt-0.5">已計算景點距離目前位置</p>
                    </div>
                </div>
            </div>

            <!-- Map View Quick Switch Controls -->
            <div class="absolute bottom-4 left-4 z-20 flex flex-wrap gap-2">
                <button onclick="centerOnKorea()" class="px-3 py-1.5 bg-white/90 border border-purple-200 hover:bg-purple-50 text-slate-700 rounded-xl text-xs backdrop-blur-md shadow-sm transition flex items-center gap-1.5 font-medium">
                    <i class="fa-solid fa-earth-asia text-xs text-purple-600"></i> 回韓國首爾全區
                </button>
            </div>
        </div>

        <!-- Sidebar Column -->
        <div class="w-full md:w-96 lg:w-[420px] bg-white border-t md:border-t-0 md:border-l border-purple-100 flex flex-col h-[50vh] md:h-full z-20 shadow-lg">
            
            <!-- Sidebar Header Tabs -->
            <div class="border-b border-purple-100 px-3 py-2.5 shrink-0 bg-purple-50/30">
                <div class="flex items-center justify-between mb-2">
                    <span id="sidebar-count-badge" class="px-2.5 py-0.5 rounded-full bg-purple-100 text-purple-700 text-xs font-bold border border-purple-200">
                        0 個巡禮打卡點
                    </span>
                    <div class="flex items-center gap-2">
                        <button id="saved-spots-toggle" onclick="toggleSavedOnly()" class="px-2.5 py-1 rounded-xl bg-white text-purple-700 text-[11px] font-bold border border-purple-200 transition shadow-sm">
                            <i class="fa-regular fa-bookmark mr-1"></i>我的收藏 <span id="saved-spots-count">0</span>
                        </button>
                        <span class="text-[11px] text-slate-500">點擊地標查看導航與攻略</span>
                    </div>
                </div>
                
                <!-- View Mode Segment Control -->
                <div class="grid grid-cols-3 bg-purple-100/60 p-1 rounded-xl border border-purple-200 text-xs text-center font-semibold">
                    <button id="tab-btn-spots" onclick="switchSidebarTab('spots')" class="py-1.5 rounded-lg text-white bg-purple-600 font-bold shadow-sm transition">
                        <i class="fa-solid fa-map-pin mr-1"></i>景點列表
                    </button>
                    <button id="tab-btn-events" onclick="switchSidebarTab('events')" class="py-1.5 rounded-lg text-slate-600 hover:text-purple-700 transition">
                        <i class="fa-solid fa-cake-candles mr-1 text-amber-500"></i>應援活動
                    </button>
                    <button id="tab-btn-community" onclick="switchSidebarTab('community')" class="py-1.5 rounded-lg text-slate-600 hover:text-purple-700 transition">
                        <i class="fa-solid fa-users mr-1 text-pink-500"></i>打卡動態
                    </button>
                </div>
            </div>

            <!-- TAB 1: Spots List View -->
            <div id="tab-content-spots" class="flex-1 overflow-y-auto p-3.5 space-y-3 custom-scrollbar"></div>

            <!-- TAB 2: Fan Events & Birthday Cafes Directory -->
            <div id="tab-content-events" class="hidden flex-1 overflow-y-auto p-3.5 space-y-3 custom-scrollbar">
                <div class="bg-gradient-to-r from-amber-50 via-purple-50 to-pink-50 border border-amber-200/80 rounded-2xl p-3 shadow-sm">
                    <div class="flex items-center justify-between text-xs font-bold text-amber-800">
                        <span><i class="fa-solid fa-cake-candles text-amber-500 mr-1"></i> 偶像應援活動宣傳欄</span>
                        <button onclick="openAddEventModal()" class="text-[11px] underline text-pink-600 hover:text-pink-700">+ 發布我的應援</button>
                    </div>
                    <p class="text-[11px] text-slate-600 mt-1 leading-relaxed">
                        匯集生日咖啡廳、杯套應援、照片展覽與觀影活動！附特典領取資訊。
                    </p>
                </div>
                <div id="events-list-container" class="space-y-3"></div>
            </div>

            <!-- TAB 3: Community & Friends Check-in Feed -->
            <div id="tab-content-community" class="hidden flex-1 overflow-y-auto p-3.5 space-y-3.5 custom-scrollbar">
                
                <!-- Friends Toggle Switch -->
                <div class="bg-purple-50/60 border border-purple-100 rounded-2xl p-2.5 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-user-group text-pink-500 text-sm"></i>
                        <div>
                            <span class="text-xs font-bold text-slate-800 block">過濾好友動態</span>
                            <span class="text-[10px] text-slate-500">只顯示已加入好友的打卡</span>
                        </div>
                    </div>
                    <button id="toggle-friends-feed" onclick="toggleFriendsOnlyFeed()" class="px-3 py-1 rounded-xl bg-white text-purple-700 text-xs font-bold border border-purple-200 transition shadow-sm">
                        全部粉絲
                    </button>
                </div>

                <div id="community-feed-container" class="space-y-3"></div>
            </div>

        </div>

    </div>

    
    <!-- MODAL 0: Normal Camera / Photo Picker -->
    <div id="camera-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[70] flex items-center justify-center p-4 hidden">
        <div class="bg-white border border-purple-100 rounded-3xl max-w-md w-full p-5 relative shadow-2xl">
            <button onclick="closeCameraModal()" class="absolute top-4 right-4 z-10 w-8 h-8 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-full flex items-center justify-center border border-slate-200">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <h3 class="text-base font-bold text-slate-800 mb-2 flex items-center gap-2">
                <i class="fa-solid fa-camera text-purple-600"></i> 拍攝照片
            </h3>
            <p class="text-xs text-slate-500 mb-4">使用裝置的相機拍照，或從相簿選擇照片。</p>
            <input id="camera-file-input" type="file" accept="image/*" capture="environment" class="hidden" onchange="handleCameraFile(this)">
            <input id="camera-gallery-input" type="file" accept="image/*" class="hidden" onchange="handleCameraFile(this)">
            <div class="flex gap-3 w-full">
                <button onclick="document.getElementById('camera-file-input').click()" class="flex-1 py-2.5 bg-purple-600 hover:bg-purple-700 text-white rounded-xl text-xs font-bold shadow-md transition">
                    <i class="fa-solid fa-camera text-sm mr-1"></i> 拍照
                </button>
                <button onclick="document.getElementById('camera-gallery-input').click()" class="flex-1 py-2.5 bg-pink-50 hover:bg-pink-100 text-pink-700 rounded-xl text-xs font-bold border border-pink-200 transition">
                    <i class="fa-solid fa-images text-sm mr-1"></i> 從相簿選擇
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL 1: Personal Profile & Check-in Homepage -->
    <div id="profile-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white border border-purple-100 rounded-3xl max-w-xl w-full max-h-[90vh] overflow-y-auto custom-scrollbar shadow-2xl p-5 sm:p-6 relative flex flex-col">
            
            <button onclick="closeProfileModal()" class="absolute top-4 right-4 z-10 text-slate-400 hover:text-slate-700 w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center border border-slate-200 transition">
                <i class="fa-solid fa-xmark text-base"></i>
            </button>

            <!-- Profile Banner & Main Avatar Info Header -->
            <div class="bg-gradient-to-br from-purple-50 via-white to-pink-50 border border-purple-100 p-4 rounded-2xl mb-5 relative overflow-hidden shadow-sm">
                <div class="flex flex-col sm:flex-row items-center gap-4 relative z-10">
                    <div class="relative group">
                        <img id="profile-avatar-img" class="w-20 h-20 rounded-2xl object-cover border-2 border-purple-300 shadow-md">
                        
                        <!-- Avatar Actions Buttons -->
                        <div class="flex gap-1.5 absolute -bottom-2 -right-1">
                            <button onclick="triggerCameraCapture('profile-avatar-img', setProfileAvatar)" title="相機拍照" class="w-7 h-7 rounded-xl bg-purple-600 hover:bg-purple-700 text-white flex items-center justify-center text-xs shadow-md border border-white">
                                <i class="fa-solid fa-camera"></i>
                            </button>
                            <label title="從相簿選擇" class="cursor-pointer w-7 h-7 rounded-xl bg-pink-600 hover:bg-pink-700 text-white flex items-center justify-center text-xs shadow-md border border-white">
                                <i class="fa-solid fa-images"></i>
                                <input type="file" accept="image/*" onchange="previewImageFile(this, 'profile-avatar-img', setProfileAvatar)" class="hidden">
                            </label>
                        </div>
                    </div>

                    <div class="text-center sm:text-left flex-1 min-w-0">
                        <div class="flex items-center justify-center sm:justify-start gap-2">
                            <h2 id="profile-display-name" class="text-lg font-black text-slate-800 truncate"></h2>
                            <span class="px-2 py-0.5 rounded-full bg-pink-100 text-pink-600 border border-pink-200 text-[10px] font-bold">VIP 粉絲</span>
                        </div>
                        <p id="profile-handle-id" class="text-xs text-purple-600 font-mono font-semibold mt-0.5"></p>
                        <p class="text-[11px] text-slate-500 mt-1">✨ 我的專屬打卡站名片・追星紀錄與地圖導航主頁</p>
                    </div>
                </div>

                <!-- Stats Dashboard -->
                <div class="grid grid-cols-3 gap-2 mt-4 pt-3 border-t border-purple-100 text-center">
                    <div class="bg-white/80 p-2 rounded-xl border border-purple-100 shadow-xs">
                        <span class="block text-[10px] text-slate-400 uppercase font-bold">我的打卡次數</span>
                        <span id="user-stats-checkins" class="text-base font-black text-pink-600">0</span>
                    </div>
                    <div class="bg-white/80 p-2 rounded-xl border border-purple-100 shadow-xs">
                        <span class="block text-[10px] text-slate-400 uppercase font-bold">造訪景點數</span>
                        <span id="user-stats-spots" class="text-base font-black text-purple-600">0</span>
                    </div>
                    <div class="bg-white/80 p-2 rounded-xl border border-purple-100 shadow-xs">
                        <span class="block text-[10px] text-slate-400 uppercase font-bold">追星好友</span>
                        <span id="user-stats-friends" class="text-base font-black text-amber-600">0</span>
                    </div>
                </div>
            </div>

            <!-- Profile Navigation Tabs -->
            <div class="grid grid-cols-3 bg-purple-50 p-1 rounded-xl border border-purple-100 text-xs font-bold text-center mb-4 shrink-0">
                <button id="prof-tab-checkins" onclick="switchProfileTab('checkins')" class="py-1.5 rounded-lg bg-purple-600 text-white shadow-sm transition">
                    <i class="fa-solid fa-camera-retro mr-1"></i>我的打卡
                </button>
                <button id="prof-tab-friends" onclick="switchProfileTab('friends')" class="py-1.5 rounded-lg text-slate-600 hover:text-purple-700 transition">
                    <i class="fa-solid fa-user-group mr-1"></i>追星好友
                </button>
                <button id="prof-tab-edit" onclick="switchProfileTab('edit')" class="py-1.5 rounded-lg text-slate-600 hover:text-purple-700 transition">
                    <i class="fa-solid fa-pen-to-square mr-1"></i>帳號設定
                </button>
            </div>

            <!-- Profile Tab 1: My Personal Check-ins Timeline -->
            <div id="prof-sec-checkins" class="space-y-3 max-h-80 overflow-y-auto custom-scrollbar">
                <div class="flex items-center justify-between text-xs font-bold text-slate-700 mb-1">
                    <span><i class="fa-solid fa-timeline text-pink-500 mr-1"></i> 個人巡禮認證歷史紀錄</span>
                    <span class="text-[11px] text-slate-400">點擊可重新跳轉至地點</span>
                </div>
                <div id="user-my-checkins-list" class="space-y-2.5"></div>
            </div>

            <!-- Profile Tab 2: Friends List -->
            <div id="prof-sec-friends" class="hidden space-y-4">
                <div class="flex gap-2">
                    <input type="text" id="add-friend-input" placeholder="輸入好友 ID 或名稱 (例: ARMY_sora)" class="flex-1 bg-slate-50 border border-purple-200 rounded-xl px-3 py-2 text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-400">
                    <button onclick="addNewFriend()" class="px-4 py-2 bg-pink-600 hover:bg-pink-700 text-white text-xs font-bold rounded-xl shadow-sm transition">
                        <i class="fa-solid fa-user-plus mr-1"></i> 加好友
                    </button>
                </div>
                <div id="friends-list-container" class="space-y-2 max-h-60 overflow-y-auto custom-scrollbar"></div>
            </div>

            <!-- Profile Tab 3: Edit Profile Info Form -->
            <div id="prof-sec-edit" class="hidden space-y-4 text-xs">
                <div>
                    <label class="block text-slate-700 font-semibold mb-1">您的追星暱稱</label>
