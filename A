        // Render Community & Friends Check-in Feed
        function renderCommunityFeed() {
            const feedContainer = document.getElementById('community-feed-container');
            if (!feedContainer) return;

            let allCheckins = [];

            SPOTS.forEach(spot => {
                spot.checkins.forEach(c => {
                    const isFriend = currentUser.friends.some(f => f.handle.toLowerCase() === (c.userHandle || '').toLowerCase());
                    allCheckins.push({
                        ...c,
                        spotTitle: spot.title,
                        groupName: spot.groupName,
                        spotId: spot.id,
                        isFriend: isFriend
                    });
                });
            });

            if (showFriendsOnlyFeed) {
                allCheckins = allCheckins.filter(c => c.isFriend);
            }

            if (allCheckins.length === 0) {
                feedContainer.innerHTML = `
                    <div class="text-center py-10 text-slate-400">
                        <i class="fa-solid fa-user-group text-2xl mb-2 text-slate-300 block"></i>
                        <p class="text-xs">${showFriendsOnlyFeed ? '您的好友尚未發表打卡紀錄。' : '暫無巡禮打卡動態。快成為第一個打卡認證的人吧！'}</p>
                    </div>
                `;
                return;
            }

            feedContainer.innerHTML = allCheckins.map(post => `
                <div onclick="openSpotModal(${post.spotId})" class="bg-white hover:bg-purple-50/50 p-3.5 rounded-2xl border ${post.isFriend ? 'border-pink-300 bg-pink-50/30' : 'border-purple-100'} cursor-pointer transition shadow-xs">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-2">
                            <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-purple-500 to-pink-500 flex items-center justify-center text-white text-xs font-bold">
                                ${post.name.charAt(0)}
                            </div>
                            <div>
                                <div class="flex items-center gap-1.5">
                                    <h4 class="text-xs font-bold text-slate-800">${post.name}</h4>
                                    ${post.isFriend ? `<span class="bg-pink-100 text-pink-600 text-[9px] px-1.5 py-0.2 rounded font-bold border border-pink-200">好友</span>` : ''}
                                </div>
                                <span class="text-[10px] text-slate-400">${post.date}</span>
                            </div>
                        </div>
                        <span class="text-[10px] px-2 py-0.5 rounded bg-purple-100 text-purple-700 font-semibold border border-purple-200">
                            ${post.groupName}
                        </span>
                    </div>
                    <p class="text-xs text-slate-700 mb-2">${post.note}</p>
                    ${post.photo ? `<img src="${post.photo}" class="w-full h-36 object-cover rounded-xl mb-2 border border-slate-200">` : ''}
                    <div class="text-[11px] text-purple-600 font-semibold flex items-center gap-1">
                        <i class="fa-solid fa-location-dot"></i> 打卡於: ${post.spotTitle}
                    </div>
                </div>
            `).join('');
        }

        function toggleFriendsOnlyFeed() {
            showFriendsOnlyFeed = !showFriendsOnlyFeed;
            const btn = document.getElementById('toggle-friends-feed');
            if (showFriendsOnlyFeed) {
                btn.className = 'px-3 py-1 rounded-xl bg-pink-600 text-white text-xs font-bold shadow-sm transition';
                btn.innerText = '僅看好友';
            } else {
                btn.className = 'px-3 py-1 rounded-xl bg-white text-purple-700 text-xs font-bold border border-purple-200 transition shadow-sm';
                btn.innerText = '全部粉絲';
            }
            renderCommunityFeed();
        }

        function switchSidebarTab(tab) {
            const spotsBtn = document.getElementById('tab-btn-spots');
            const eventsBtn = document.getElementById('tab-btn-events');
            const commBtn = document.getElementById('tab-btn-community');

            const spotsContent = document.getElementById('tab-content-spots');
            const eventsContent = document.getElementById('tab-content-events');
            const commContent = document.getElementById('tab-content-community');

            const inactive = 'py-1.5 rounded-lg text-slate-600 hover:text-purple-700 transition font-semibold';
            const active = 'py-1.5 rounded-lg text-white bg-purple-600 font-bold transition shadow-sm';

            spotsBtn.className = inactive;
            eventsBtn.className = inactive;
            commBtn.className = inactive;

            spotsContent.classList.add('hidden');
            eventsContent.classList.add('hidden');
            commContent.classList.add('hidden');

            if (tab === 'spots') {
                spotsBtn.className = active;
                spotsContent.classList.remove('hidden');
            } else if (tab === 'events') {
                eventsBtn.className = active;
                eventsContent.classList.remove('hidden');
                renderEventsList();
            } else {
                commBtn.className = active;
                commContent.classList.remove('hidden');
                renderCommunityFeed();
            }
        }

        function initMap() {
            map = L.map('map', { zoomControl: false }).setView([37.5665, 126.9780], 12);

            // Light Voyager Basemap suitable for Light Purple theme
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                maxZoom: 19,
                subdomains: 'abcd',
                attribution: '&copy; OpenStreetMap &copy; CARTO'
            }).addTo(map);

            L.control.zoom({ position: 'topright' }).addTo(map);

            map.on('click', function(e) {
                const lat = e.latlng.lat.toFixed(6);
                const lng = e.latlng.lng.toFixed(6);

                if (isPickingLocation) {
                    if (pickingMode === 'spot') {
                        document.getElementById('add-lat').value = lat;
                        document.getElementById('add-lng').value = lng;
                    } else {
                        document.getElementById('event-lat').value = lat;
                        document.getElementById('event-lng').value = lng;
                    }

                    if (tempPickerMarker) map.removeLayer(tempPickerMarker);

                    const pickIcon = L.divIcon({
                        className: 'pick-pin',
                        html: `
                            <div class="w-8 h-8 rounded-full bg-pink-500 border-2 border-white shadow-xl flex items-center justify-center text-white animate-bounce">
                                <i class="fa-solid fa-location-crosshairs text-sm"></i>
                            </div>
                        `,
                        iconSize: [32, 32],
                        iconAnchor: [16, 16]
                    });

                    tempPickerMarker = L.marker([lat, lng], { icon: pickIcon }).addTo(map);

                    isPickingLocation = false;
                    document.getElementById('picking-location-banner').classList.add('hidden');

                    if (pickingMode === 'spot') openAddSpotModal();
                    else openAddEventModal();

                    showToast(`已設定座標：${lat}, ${lng}`, 'fa-location-dot');
                }
            });
        }

        function centerOnKorea() {
            if (map) map.flyTo([37.5665, 126.9780], 12, { duration: 1.5 });
        }

        function startLocationPicker(mode) {
            pickingMode = mode;
            if (mode === 'spot') closeAddSpotModal();
            else closeAddEventModal();

            isPickingLocation = true;
            document.getElementById('picking-location-banner').classList.remove('hidden');
            showToast('請在地圖上點選地點座標！', 'fa-hand-pointer');
        }

        function cancelLocationPicker() {
            isPickingLocation = false;
            document.getElementById('picking-location-banner').classList.add('hidden');
            if (tempPickerMarker) map.removeLayer(tempPickerMarker);
            if (pickingMode === 'spot') openAddSpotModal();
            else openAddEventModal();
        }

        // Modal Handlers
        function openAddSpotModal() {
            document.getElementById('add-modal').classList.remove('hidden');
        }

        function closeAddSpotModal() {
            document.getElementById('add-modal').classList.add('hidden');
        }

        function openAddEventModal() {
            document.getElementById('add-event-modal').classList.remove('hidden');
        }

        function closeAddEventModal() {
            document.getElementById('add-event-modal').classList.add('hidden');
        }

        function handleAddSpot(e) {
            e.preventDefault();
            const groupSelect = document.getElementById('add-group');
            const groupId = groupSelect.value;
            const groupObj = GROUPS.find(g => g.id === groupId) || { name: 'K-POP Group' };

            const newSpot = {
                id: Date.now(),
                isEvent: false,
                groupId: groupId,
                groupName: groupObj.name,
                idolName: document.getElementById('add-idol').value,
                title: document.getElementById('add-title').value,
                category: document.getElementById('add-category').value,
                lat: parseFloat(document.getElementById('add-lat').value),
                lng: parseFloat(document.getElementById('add-lng').value),
                address: document.getElementById('add-address').value,
                hours: document.getElementById('add-hours').value || '尚未提供',
                visitDate: '粉絲推薦打卡',
                description: document.getElementById('add-desc').value || '暫無詳細說明。',
                heroImage: uploadedSpotPhoto || 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?w=800&q=80',
                checkins: []
            };

            SPOTS.unshift(newSpot);
            closeAddSpotModal();
            document.getElementById('add-spot-form').reset();
            document.getElementById('preview-add-spot').classList.add('hidden');
            uploadedSpotPhoto = null;

            renderSpots();
            showToast("成功發布新景點至地圖！", "fa-map-pin");
            map.flyTo([newSpot.lat, newSpot.lng], 14);
        }

        function handleAddEvent(e) {
            e.preventDefault();
            const groupSelect = document.getElementById('event-group');
            const groupId = groupSelect.value;
            const groupObj = GROUPS.find(g => g.id === groupId) || { name: 'K-POP Group' };

            const startDate = document.getElementById('event-start-date').value;
            const endDate = document.getElementById('event-end-date').value;

            const newEvent = {
                id: Date.now(),
                isEvent: true,
                groupId: groupId,
                groupName: groupObj.name,
                idolName: document.getElementById('event-idol').value,
                title: document.getElementById('event-title').value,
                category: '應援活動',
                lat: parseFloat(document.getElementById('event-lat').value),
                lng: parseFloat(document.getElementById('event-lng').value),
                address: document.getElementById('event-address').value,
                hours: '見活動說明',
                visitDate: `${startDate} ~ ${endDate}`,
                perks: document.getElementById('event-perks').value || '發完為止',
                description: document.getElementById('event-desc').value || '歡迎所有粉絲前往打卡祝賀！',
                heroImage: uploadedEventPoster || 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=800&q=80',
                checkins: []
            };

            SPOTS.unshift(newEvent);
            closeAddEventModal();
            document.getElementById('add-event-form').reset();
            document.getElementById('preview-event-poster').classList.add('hidden');
            uploadedEventPoster = null;

            renderSpots();
            renderEventsList();
            showToast("成功發布應援活動！", "fa-cake-candles");
            map.flyTo([newEvent.lat, newEvent.lng], 14);
        }

        // Spot Detail Modal Display
        function openSpotModal(spotId) {
            const spot = SPOTS.find(s => s.id === spotId);
            if (!spot) return;

            activeSpotForCheckin = spot;

            const groupObj = GROUPS.find(g => g.id === spot.groupId) || { color: '#9333ea', name: spot.groupName };

            document.getElementById('modal-title').innerText = spot.title;
            document.getElementById('modal-idol-info').innerText = `${spot.groupName} ・ ${spot.idolName}`;
            document.getElementById('modal-hours').innerText = spot.hours;
            document.getElementById('modal-address').innerText = spot.address;
            document.getElementById('modal-visit-date').innerText = spot.visitDate;
            document.getElementById('modal-description').innerText = spot.description;

            // Badges
            const badgesContainer = document.getElementById('modal-badges');
            badgesContainer.innerHTML = `
                <span class="text-xs px-2.5 py-0.5 rounded-md font-bold text-white shadow-xs" style="background-color: ${spot.isEvent ? '#f59e0b' : groupObj.color}">
                    ${spot.isEvent ? '🎂 生日/應援活動' : spot.groupName}
                </span>
                <span class="text-xs px-2.5 py-0.5 rounded-md font-bold bg-purple-100 text-purple-700 border border-purple-200">
                    ${spot.category}
                </span>
            `;

            // Distance calculation
            const distElem = document.getElementById('modal-distance');
            if (userLocation) {
                const d = calculateDistance(userLocation.lat, userLocation.lng, spot.lat, spot.lng);
                distElem.innerText = formatDistance(d);
            } else {
                distElem.innerText = '請先啟用「我的真實定位」';
            }

            // Image Gallery
            const gallery = document.getElementById('modal-image-gallery');
            gallery.innerHTML = `
                <img src="${spot.heroImage}" class="w-full h-full object-cover shrink-0 snap-center">
            `;

            // Nav links
            document.getElementById('modal-nav-kakao').onclick = function() {
                window.open(`https://map.kakao.com/link/to/${encodeURIComponent(spot.title)},${spot.lat},${spot.lng}`, '_blank');
            };
            document.getElementById('modal-nav-google').onclick = function() {
                window.open(`https://www.google.com/maps/dir/?api=1&destination=${spot.lat},${spot.lng}`, '_blank');
            };
            document.getElementById('modal-checkin-btn').onclick = function() {
                openUserCheckinModal(spot);
            };
            document.getElementById('modal-save-btn').onclick = function() {
                toggleSaveSpot(spot.id);
            };
            updateModalSaveButton(spot);

            // Render Check-ins
            renderModalCheckins(spot);

            document.getElementById('spot-modal').classList.remove('hidden');
        }

        function closeSpotModal() {
            document.getElementById('spot-modal').classList.add('hidden');
        }

        function renderModalCheckins(spot) {
            const listElem = document.getElementById('modal-checkin-list');
            const countElem = document.getElementById('modal-checkin-count');

            countElem.innerText = spot.checkins.length;

            if (spot.checkins.length === 0) {
                listElem.innerHTML = `<p class="text-xs text-slate-400 text-center py-4 bg-purple-50/30 rounded-xl">尚無打卡紀錄，快來按下「我要打卡」成為第一個認證的人吧！</p>`;
                return;
            }

            listElem.innerHTML = spot.checkins.map(c => `
                <div class="bg-purple-50/50 p-3 rounded-2xl border border-purple-100 flex gap-3">
                    ${c.photo ? `<img src="${c.photo}" class="w-16 h-16 rounded-xl object-cover shrink-0 border border-purple-200">` : ''}
                    <div class="flex-1 min-w-0 text-xs">
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-bold text-slate-800">${c.name}</span>
                            <span class="text-[10px] text-slate-400">${c.date}</span>
                        </div>
                        <p class="text-slate-600 line-clamp-2">${c.note}</p>
                    </div>
                </div>
            `).join('');
        }

        // Fan Check-in Submission
        function openUserCheckinModal(spot) {
            activeSpotForCheckin = spot;
            document.getElementById('checkin-modal-spot-title').innerText = spot.title;
            document.getElementById('checkin-user-name-display').value = `${currentUser.name} (@${currentUser.handle})`;
            document.getElementById('user-checkin-modal').classList.remove('hidden');
        }

        function closeUserCheckinModal() {
            document.getElementById('user-checkin-modal').classList.add('hidden');
            document.getElementById('checkin-form').reset();
            document.getElementById('preview-checkin-photo').classList.add('hidden');
            uploadedCheckinPhoto = null;
        }

        function handleUserCheckin(e) {
            e.preventDefault();
            if (!activeSpotForCheckin) return;

            const today = new Date().toISOString().split('T')[0];
            const newCheckin = {
                id: `ck-${Date.now()}`,
                name: currentUser.name,
                userHandle: currentUser.handle,
                date: today,
                note: document.getElementById('checkin-note').value,
                photo: uploadedCheckinPhoto || ''
            };

            activeSpotForCheckin.checkins.unshift(newCheckin);

            closeUserCheckinModal();
            renderModalCheckins(activeSpotForCheckin);
            renderCommunityFeed();
            updateProfileDashboardStats();

            showToast("成功完成巡禮打卡認證！", "fa-camera-retro");
        }

        // Initialize on Window Load
        window.onload = function() {
            initMap();
            renderGroupPills();
            populateGroupSelects();
            renderSpots();
            updateSavedSpotsUI();

            // 一開始就詢問定位權限
            setTimeout(() => requestRealGPS(), 300);

            // Set Header user info
            document.getElementById('header-user-avatar').src = currentUser.avatar;
            document.getElementById('header-user-name').innerText = currentUser.name;
            document.getElementById('friends-badge-count').innerText = currentUser.friends.length;
        };
    </script>
</body>
</html>
