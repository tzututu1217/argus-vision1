                const matchSaved = !showSavedOnly || savedSpotIds.includes(spot.id);
                const matchCategory = category === 'ALL' || 
                    (category === '應援活動' && spot.isEvent) ||
                    (category !== '應援活動' && spot.category === category);
                
                const matchSearch = !search || 
                    spot.title.toLowerCase().includes(search) || 
                    spot.idolName.toLowerCase().includes(search) || 
                    spot.groupName.toLowerCase().includes(search) || 
                    spot.address.toLowerCase().includes(search) ||
                    spot.description.toLowerCase().includes(search);

                return matchGroup && matchCategory && matchSearch && matchSaved;
            });
